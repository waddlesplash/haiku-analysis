 }
 
 
+#define memcpy local_memcpy
+static void*
+memcpy(void* dest, const void* source, size_t count)
+{
+	if (count == 0 || dest == source)
+		return dest;
+
+	uint8_t* d = (uint8_t*)dest;
+	const uint8_t* s = (const uint8_t*)source;
+
+	while (count > 0) {
+		*d = *s;
+		d++;
+		s++;
+		count--;
+	}
+
+	return dest;
+}
+
+extern status_t		user_memcpy_physical(void *to, const void *from, size_t size);
+
 inline status_t
 X86PhysicalPageMapper::MemcpyFromPhysical(void* to, phys_addr_t _from,
 	size_t length, bool user)
@@ -176,7 +200,7 @@ X86PhysicalPageMapper::MemcpyToPhysical(phys_addr_t _to, const void* from,
 	auto to = (void*)(_to + KERNEL_PMAP_BASE);
 
 	if (user)
-		return user_memcpy(to, from, length);
+		return user_memcpy_physical(to, from, length);
 
 	memcpy(to, from, length);
 	return B_OK;
@@ -191,6 +215,7 @@ X86PhysicalPageMapper::MemcpyPhysicalPage(phys_addr_t to,
 		B_PAGE_SIZE);
 }
 
+#undef memcpy
 
 status_t mapped_physical_page_ops_init(kernel_args* args,
 	X86PhysicalPageMapper*& _pageMapper,
