+static void
+check_physical_access(phys_addr_t physicalAddress)
+{
+	if (debug_debugger_running())
+		return;
+	vm_page* page = vm_lookup_page(physicalAddress / B_PAGE_SIZE);
+	if (page != NULL) {
+		if (page->accessing_thread == thread_get_current_thread_id())
+			return;
+
+		ASSERT(page->accessing_thread == -1);
+		ASSERT(page->State() != PAGE_STATE_FREE && page->State() != PAGE_STATE_CLEAR);
+		ASSERT(
+			//(page->busy && (addr_t)address >= KERNEL_PMAP_BASE && (addr_t)address <= (KERNEL_PMAP_BASE+KERNEL_PMAP_SIZE)) ||
+			(page->busy && page->Cache() != NULL && (page->Cache()->type == CACHE_TYPE_VNODE || page->Cache()->type == CACHE_TYPE_NULL)) ||
+			(page->WiredCount() || page->State() == PAGE_STATE_WIRED));
+	}
+}
+
+
+static void
+check_physical_access_range(phys_addr_t _address, phys_size_t length)
+{
+	phys_addr_t address = ROUNDDOWN(_address, B_PAGE_SIZE);
+	length += _address - address;
+	for (phys_size_t i = 0; i < length; i += B_PAGE_SIZE)
+		check_physical_access(address + i);
+}
+
+
 status_t
 vm_memset_physical(phys_addr_t address, int value, phys_size_t length)
 {
+	if (value != 0)
+		check_physical_access_range(address, length);
 	return sPhysicalPageMapper->MemsetPhysical(address, value, length);
 }
 
@@ -4805,6 +4837,8 @@ vm_memset_physical(phys_addr_t address, int value, phys_size_t length)
 status_t
 vm_memcpy_from_physical(void* to, phys_addr_t from, size_t length, bool user)
 {
+	ASSERT(!((addr_t)to >= KERNEL_PMAP_BASE && ((addr_t)to+length) < (KERNEL_PMAP_BASE+KERNEL_PMAP_SIZE)));
+	check_physical_access_range(from, length);
 	return sPhysicalPageMapper->MemcpyFromPhysical(to, from, length, user);
 }
 
@@ -4813,6 +4847,8 @@ status_t
 vm_memcpy_to_physical(phys_addr_t to, const void* _from, size_t length,
 	bool user)
 {
+	//ASSERT(!((addr_t)_from >= KERNEL_PMAP_BASE && ((addr_t)_from+length) < (KERNEL_PMAP_BASE+KERNEL_PMAP_SIZE)));
+	check_physical_access_range(to, length);
 	return sPhysicalPageMapper->MemcpyToPhysical(to, _from, length, user);
 }
 
@@ -4820,6 +4856,7 @@ vm_memcpy_to_physical(phys_addr_t to, const void* _from, size_t length,
 void
 vm_memcpy_physical_page(phys_addr_t to, phys_addr_t from)
 {
+	check_physical_access(to);
 	return sPhysicalPageMapper->MemcpyPhysicalPage(to, from);
 }
 
@@ -4856,6 +4893,38 @@ user_memcpy(void* to, const void* from, size_t size)
 }
 
 
+#define memcpy local_memcpy
+static void*
+memcpy(void* dest, const void* source, size_t count)
+{
+	if (count == 0 || dest == source)
+		return dest;
+
+	uint8_t* d = (uint8_t*)dest;
+	const uint8_t* s = (const uint8_t*)source;
+
+	while (count > 0) {
+		*d = *s;
+		d++;
+		s++;
+		count--;
+	}
+
+	return dest;
+}
+
+status_t
+user_memcpy_physical(void* to, const void* from, size_t size)
+{
+	arch_cpu_enable_user_access();
+	memcpy(to, from, size);
+	arch_cpu_disable_user_access();
+	return B_OK;
+}
+
+#undef memcpy
