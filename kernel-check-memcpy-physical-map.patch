 		cookie->vec_offset = 0;
 	}
 
+	cookie->debug_page = vm_lookup_page(address / B_PAGE_SIZE);
+	cookie->debug_cache = cookie->debug_page->Cache();
+	cookie->debug_state = cookie->debug_page->State();
