 				pages[index] = vm_page_allocate_page(&reservation,
 					PAGE_STATE_UNUSED);
+				pages[index]->busy = true;
+				pages[index]->busy_io = true;
 				DEBUG_PAGE_ACCESS_END(pages[index]);
