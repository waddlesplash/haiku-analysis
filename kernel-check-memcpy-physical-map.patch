 .../packagefs/package/CachedDataReader.cpp    |  4 ++
 .../x86/paging/64bit/X86PagingMethod64Bit.cpp | 16 +++--
 .../paging/64bit/X86VMTranslationMap64Bit.cpp | 19 +++--
 .../paging/x86_physical_page_mapper_mapped.h  | 27 ++++++-
 .../kernel/device_manager/IORequest.cpp       | 35 +++++++++
 src/system/kernel/vm/vm.cpp                   | 71 +++++++++++++++++++
 .../posix/string/arch/x86_64/memcpy.cpp       |  8 +++
 8 files changed, 172 insertions(+), 10 deletions(-)

